APP_NAME="SocialPilot AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Settings (Local development uses SQLite; MySQL / TiDB ready for production)
DB_CONNECTION=sqlite
# For TiDB Serverless Production (MySQL 8.0 wire protocol):
# DB_CONNECTION=mysql
# DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_DATABASE=socialpilot
# DB_USERNAME=<prefix>.root
# DB_PASSWORD=
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# TiDB Serverless Migration Test Database
# TIDB_TEST_DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
# TIDB_TEST_DB_PORT=4000
# TIDB_TEST_DB_DATABASE=socialpilot_migration_test
# TIDB_TEST_DB_USERNAME=<prefix>.root
# TIDB_TEST_DB_PASSWORD=
# TIDB_TEST_MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email & Notifications (Local log active; SMTP / 3rd-party ready)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Third-Party Transactional Mail & Slack
POSTMARK_API_KEY=
RESEND_API_KEY=
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

# Legal & Compliance
TERMS_VERSION=1.0
CONTACT_EMAIL=

VITE_APP_NAME="${APP_NAME}"

# ==============================================================================
# MOBILE APP API INTEGRATION
# ==============================================================================
# Web / Standard API Endpoint: http://localhost:8000 or http://127.0.0.1:8000
# Android Emulator API Endpoint: http://10.0.2.2:8000
API_BASE_URL=http://localhost:8000
MOBILE_API_BASE_URL=http://localhost:8000
MOBILE_ANALYTICS_API_BASE_URL=http://localhost:8000
MOBILE_PUBLISHING_API_BASE_URL=http://localhost:8000

# ==============================================================================
# AI ENGINE CORE INTEGRATION (FastAPI <-> Laravel Bridge)
# ==============================================================================
AI_ENGINE_URL=http://127.0.0.1:8080
AI_ENGINE_INTERNAL_TOKEN=
TREND_ENGINE_URL=http://127.0.0.1:8080
TREND_ENGINE_INTERNAL_TOKEN=
PUBLISHING_INTERNAL_TOKEN=

# ==============================================================================
# MULTI-AI TEXT & CONTENT GENERATION PROVIDERS
# ==============================================================================
# Default provider: internal | openai | gemini | openrouter | ollama
AI_PROVIDER=internal
AI_MODEL=socialpilot-lite

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Local Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
TREND_ENABLE_OLLAMA_ANALYSIS=false

# ==============================================================================
# TREND RESEARCH & INTELLIGENCE MULTI-SOURCE APIS
# ==============================================================================
TREND_RSS_FEEDS=https://feeds.bbci.co.uk/news/rss.xml
NEWSAPI_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SocialPilotAI/1.0
YOUTUBE_API_KEY=
GOOGLE_TRENDS_API_KEY=
SERPAPI_API_KEY=

# ==============================================================================
# AI MEDIA GENERATION (Images & Videos)
# ==============================================================================
# Image provider: openai | stability | gemini
IMAGE_GENERATION_PROVIDER=
OPENAI_IMAGE_MODEL=dall-e-3
STABILITY_API_KEY=
STABILITY_MODEL=stable-diffusion-xl-1024-v1-0
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002

# Video provider: runway | stability_video | pika
VIDEO_GENERATION_PROVIDER=
RUNWAY_API_KEY=
STABILITY_VIDEO_API_KEY=
PIKA_API_KEY=

MEDIA_STORAGE_DISK=local
MEDIA_MAX_UPLOAD_MB=20
MEDIA_GENERATION_TIMEOUT=120

# ==============================================================================
# SOCIAL MEDIA PLATFORMS (OAuth 2.0 & Publishing APIs)
# ==============================================================================
# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/social/oauth/linkedin/callback

# Meta (Facebook & Instagram)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/social/oauth/facebook/callback
META_GRAPH_API_VERSION=v22.0

# X (Twitter)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/social/oauth/x/callback

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/social/oauth/tiktok/callback

# Google / YouTube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/social/oauth/youtube/callback
YOUTUBE_API_KEY=

# ==============================================================================
# CLOUD OBJECT STORAGE (AWS S3 / MinIO)
# ==============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==============================================================================
# SECURITY & PRODUCTION HARDENING
# ==============================================================================
# CORS: comma-separated list of allowed origins (use * only for local dev)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Sanctum token lifetime in minutes (null = never expire)
SANCTUM_TOKEN_EXPIRATION_MINUTES=10080

# Force HTTPS scheme in production (set to true behind reverse proxy / CDN)
FORCE_HTTPS=false
