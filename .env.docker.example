# ==============================================================================
# SOCIALPILOT AI — DOCKER ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.docker and populate with secure local development values.
# DO NOT commit .env.docker to version control.
# ==============================================================================

# Application Configuration
APP_NAME=SocialPilot AI
APP_ENV=local
APP_DEBUG=false
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_URL=http://localhost:8000
FORCE_HTTPS=false

# Host Port Bindings
LARAVEL_HOST_PORT=8000
UNIFIED_HOST_PORT=8001

# Isolated Local Test MySQL Database (Never point to production TiDB)
DB_CONNECTION=mysql
DB_HOST=mysql-test
DB_PORT=3306
DB_DATABASE=socialpilot_local
DB_USERNAME=socialpilot_user
DB_PASSWORD=specify_local_test_db_password
MYSQL_ROOT_PASSWORD=specify_local_test_root_password

# Internal AI Microservice Authentication
AI_ENGINE_INTERNAL_TOKEN=specify_secure_internal_ai_token_32_chars
INTERNAL_CRON_SECRET=specify_secure_internal_cron_secret_32_chars

# External AI & Trend Providers (Optional for local development)
NEWSAPI_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
YOUTUBE_API_KEY=
GOOGLE_TRENDS_API_KEY=
