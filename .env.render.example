# ==============================================================================
# SOCIALPILOT AI — RENDER STAGING ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file into Render's "Environment Variables" dashboard.
# Replace every <PLACEHOLDER> value with the real value.
# Never commit a file containing real secrets to Git.
# This file contains PLACEHOLDER values only and is safe to commit.
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION CORE
# ------------------------------------------------------------------------------
APP_NAME="SocialPilot AI"
APP_ENV=production
APP_KEY=<GENERATE: php artisan key:generate --show>
APP_DEBUG=false
APP_URL=https://<your-app-name>.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------------------------
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ------------------------------------------------------------------------------
# DATABASE — TiDB Serverless (MySQL 8.0 wire protocol)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=<TIDB_GATEWAY_HOSTNAME>
DB_PORT=4000
DB_DATABASE=<TIDB_DATABASE_NAME>
DB_USERNAME=<TIDB_USERNAME>
DB_PASSWORD=<TIDB_PASSWORD>
# TiDB Serverless requires TLS. The system CA bundle path in the unified
# container (Debian Bookworm / php:8.2-fpm-bookworm base image) is:
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# ------------------------------------------------------------------------------
# SESSION, CACHE & QUEUE — All use the production database (TiDB Serverless)
# These are the application defaults; set explicitly to prevent accidents.
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=database
QUEUE_CONNECTION=database

# ------------------------------------------------------------------------------
# FILE STORAGE
# IMPORTANT: Keep local for the first staging deployment.
# Do NOT set to s3 until league/flysystem-aws-s3-v3 is installed and deployed.
# Local storage is ephemeral on Render (lost on each deploy / restart).
# This is acceptable for initial staging verification only.
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=local
MEDIA_STORAGE_DISK=local
MEDIA_MAX_UPLOAD_MB=20
MEDIA_GENERATION_TIMEOUT=120

# ------------------------------------------------------------------------------
# INTERNAL SERVICE AUTHENTICATION
# Generate strong random tokens (minimum 40 characters each).
# Use: openssl rand -hex 32
# ------------------------------------------------------------------------------
AI_ENGINE_URL=http://127.0.0.1:8080
AI_ENGINE_INTERNAL_TOKEN=<GENERATE: openssl rand -hex 32>
TREND_ENGINE_URL=http://127.0.0.1:8080
TREND_ENGINE_INTERNAL_TOKEN=<GENERATE: openssl rand -hex 32>
PUBLISHING_INTERNAL_TOKEN=<GENERATE: openssl rand -hex 32>
INTERNAL_CRON_SECRET=<GENERATE: openssl rand -hex 32>

# ------------------------------------------------------------------------------
# RENDER CONFIGURATION
# Render sets $PORT automatically. The entrypoint script reads it.
# Do not set PORT manually unless advised by Render support.
# ------------------------------------------------------------------------------
# PORT is auto-injected by Render; no entry needed here.
SKIP_CACHE_WARMUP=false

# ------------------------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------------------------
# Replace with your Render app URL and any Flutter/mobile client origins.
CORS_ALLOWED_ORIGINS=https://<your-app-name>.onrender.com
SANCTUM_STATEFUL_DOMAINS=<your-app-name>.onrender.com
SANCTUM_TOKEN_EXPIRATION_MINUTES=10080
FORCE_HTTPS=true

# ------------------------------------------------------------------------------
# AI CONTENT GENERATION PROVIDERS (optional — internal engine requires no key)
# Leave blank to use the built-in deterministic AI engine at no cost.
# ------------------------------------------------------------------------------
AI_PROVIDER=internal
AI_MODEL=socialpilot-lite
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
OLLAMA_BASE_URL=
OLLAMA_MODEL=
TREND_ENABLE_OLLAMA_ANALYSIS=false

# ------------------------------------------------------------------------------
# TREND & RESEARCH APIs (optional for staging — leave blank to use RSS only)
# ------------------------------------------------------------------------------
TREND_RSS_FEEDS=https://feeds.bbci.co.uk/news/rss.xml
NEWSAPI_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SocialPilotAI/1.0
YOUTUBE_API_KEY=
GOOGLE_TRENDS_API_KEY=
SERPAPI_API_KEY=

# ------------------------------------------------------------------------------
# AI MEDIA GENERATION (optional — disable for initial staging)
# ------------------------------------------------------------------------------
IMAGE_GENERATION_PROVIDER=
VIDEO_GENERATION_PROVIDER=
OPENAI_IMAGE_MODEL=dall-e-3
STABILITY_API_KEY=
STABILITY_MODEL=stable-diffusion-xl-1024-v1-0
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002
RUNWAY_API_KEY=
STABILITY_VIDEO_API_KEY=
PIKA_API_KEY=

# ------------------------------------------------------------------------------
# SOCIAL MEDIA PLATFORM OAUTH (required only for publishing features)
# Redirect URIs must be updated to your Render staging URL.
# ------------------------------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://<your-app-name>.onrender.com/social/oauth/linkedin/callback

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://<your-app-name>.onrender.com/social/oauth/facebook/callback
META_GRAPH_API_VERSION=v22.0

X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://<your-app-name>.onrender.com/social/oauth/x/callback

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://<your-app-name>.onrender.com/social/oauth/tiktok/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://<your-app-name>.onrender.com/social/oauth/youtube/callback

# ------------------------------------------------------------------------------
# S3 / SUPABASE STORAGE — Not enabled in first staging deployment
# Fill in after composer require league/flysystem-aws-s3-v3 is deployed.
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# ------------------------------------------------------------------------------
# EMAIL (log driver for staging — configure SMTP for production notifications)
# ------------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@<your-app-name>.onrender.com
MAIL_FROM_NAME="SocialPilot AI"

# ------------------------------------------------------------------------------
# LEGAL
# ------------------------------------------------------------------------------
TERMS_VERSION=1.0
CONTACT_EMAIL=
